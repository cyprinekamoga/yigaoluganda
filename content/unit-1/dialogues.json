  {
    "id": "dlg-tea",
    "title": {
      "en": "Tea with Jjajja",
      "sv": "Te hos Jjajja"
    },
    "setting": {
      "en": "Jjajja offers you a cup of tea.",
      "sv": "Jjajja bjuder dig på en kopp te."
    },
    "cast": {
      "jjajja": {
        "name": "Jjajja",
        "role": "elder"
      }
    },
    "lines": [
      {
        "kind": "say",
        "who": "jjajja",
        "lg": "Oyagala caayi?",
        "tr": {
          "en": "Would you like some tea?",
          "sv": "Vill du ha te?"
        }
      },
      {
        "kind": "choose",
        "prompt": {
          "en": "You'd love some. What do you say?",
          "sv": "Det vill du gärna. Vad säger du?"
        },
        "options": [
          {
            "lg": "Yee, weebale!",
            "tr": {
              "en": "Yes, thank you!",
              "sv": "Ja, tack!"
            },
            "correct": true
          },
          {
            "lg": "Nedda, weebale.",
            "tr": {
              "en": "No, thank you.",
              "sv": "Nej tack."
            },
            "why": {
              "en": "That means 'No, thank you', but you wanted tea!",
              "sv": "Det betyder 'Nej tack', men du ville ju ha te!"
            }
          },
          {
            "lg": "Nsonyiwa.",
            "tr": {
              "en": "Sorry.",
              "sv": "Förlåt."
            },
            "why": {
              "en": "Nsonyiwa means 'sorry'. You have nothing to apologise for!",
              "sv": "Nsonyiwa betyder 'förlåt'. Du har inget att be om ursäkt för!"
            }
          }
        ]
      },
      {
        "kind": "say",
        "who": "jjajja",
        "lg": "Kale.",
        "tr": {
          "en": "Okay.",
          "sv": "Okej."
        }
      },
      {
        "kind": "narrate",
        "text": {
          "en": "Jjajja hands you a warm cup.",
          "sv": "Jjajja räcker dig en varm kopp."
        }
      },
      {
        "kind": "choose",
        "prompt": {
          "en": "Thank her warmly.",
          "sv": "Tacka henne varmt."
        },
        "options": [
          {
            "lg": "Weebale nnyo!",
            "tr": {
              "en": "Thank you very much!",
              "sv": "Tack så mycket!"
            },
            "correct": true
          },
          {
            "lg": "Nedda.",
            "tr": {
              "en": "No.",
              "sv": "Nej."
            },
            "why": {
              "en": "Nedda means 'no'. Try thanking her instead.",
              "sv": "Nedda betyder 'nej'. Försök tacka henne i stället."
            }
          }
        ]
      },
      {
        "kind": "say",
        "who": "jjajja",
        "lg": "Kale, mwana wange.",
        "tr": {
          "en": "You're welcome, my child.",
          "sv": "Varsågod, mitt barn."
        }
      }
    ]
  },
